#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_USER         5
#endif

#define TWIST_MULTIPLIER   1
#define TWIST_DIVISOR      20

#define SCROLL_MULTIPLIER  1
#define SCROLL_DIVISOR     40

#define SNIPE_MULTIPLIER   1
#define SNIPE_DIVISOR      4

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
				&kp LG(LS(M))                      &mkp MCLK
				&ltmkp LAYER_EXTRAS LC(DOWN)       &mkp LCLK
				&ltmkp LAYER_SCROLL LC(UP_ARROW) 	 &mkp RCLK
				&ltm   LAYER_SNIPE MB4             &ltm LAYER_DEVICE MB5

				// rotary encoders
				&kp C_VOL_UP              &kp C_BRI_UP
				&kp C_VOL_DN              &kp C_BRI_DN
			>;
		};

		layer1 {
			display-name = "Extras";
			DECLARE_ENCODERS;
			bindings = <
				&kp LG(C)   &kp LG(V)
				&trans      &kp LG(Z)
				&kp LG(X)   &kp LG(C)
				&kp LG(Z)   &kp LG(V)

				&kp C_VOL_UP   &kp C_BRI_UP
				&kp C_VOL_DN   &kp C_BRI_DN
			>;
		};

		layer2 {
			display-name = "Device";
			DECLARE_ENCODERS;
			bindings = <
			    &zbs_adv           &bt BT_CLR
			    &bst_tog ZBS_TOG   &bt BT_NXT
			    &af_toggle AF_TOG  &bt BT_PRV
			    &studio_unlock     &trans

				&kp C_VOL_UP       &kp C_BRI_UP
				&kp C_VOL_DN       &kp C_BRI_DN
			>;
		};

		layer3 {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    &trans              &trans
			    &trans              &scrlsens P2SM_INC 1
			    &rrl 1              &scrlsens P2SM_DEC 1
			    &sens P2SM_DEC 1    &sens P2SM_INC 1

			    &sens P2SM_DEC 1    &scrlsens P2SM_INC 1
			    &sens P2SM_INC 1    &scrlsens P2SM_DEC 1
		  	>;
		};

		layer4 {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
			    &trans           &soft_off
			    &trans           &trans
			    &trans           &trans
			    &trans           &trans

			    &kp LEFT         &kp RIGHT
			    &kp RIGHT        &kp LEFT
	   		>;
		};

		layer5 {
			display-name = "User";
			DECLARE_ENCODERS;
			bindings = <
				&trans        &trans
				&trans        &trans
				&trans        &trans
				&trans        &trans

				&kp C_VOL_UP  &kp C_BRI_UP
				&kp C_VOL_DN  &kp C_BRI_DN
		    >;
		};
	};

	trackball {
		input-processors = <&zip_scroll_scaler TWIST_MULTIPLIER TWIST_DIVISOR>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>,
						   <&zip_rotate_pointer>, <&zip_rotate_scroll>,
						   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_xy_scaler SCROLL_MULTIPLIER SCROLL_DIVISOR>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_xy_scaler SNIPE_MULTIPLIER SNIPE_DIVISOR>,
							   <&zip_rotate_pointer>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};
